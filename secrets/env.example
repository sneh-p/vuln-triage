# Database Configuration
POSTGRES_HOST=postgres
POSTGRES_PORT=5412
POSTGRES_DB=vuln_triage
POSTGRES_USER=triage_user
POSTGRES_PASSWORD=secure_password_here

# Vulnerability Triage Settings
REQUIRE_HUMAN_APPROVAL=true
MAX_TICKETS_PER_DAY=25
SCANNER_EXPORT_DIR=/data/scanner-exports
TICKET_SYSTEM=autotask

# Slack Configuration
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXXXXXXXXXXXXXXXXXX

# Cavelo API Configuration
CAVELO_API_URL=https://api.cavelo.com
CAVELO_API_TOKEN=your-cavelo-api-token-here

# Datto Autotask API Configuration
AUTOTASK_API_URL=https://webservices.autotask.net/atservicesrest/v1.0
AUTOTASK_API_INTEGRATION_CODE=your-integration-code-here
AUTOTASK_USERNAME=your-username-here
AUTOTASK_SECRET=your-secret-here
AUTOTASK_QUEUE_ID=10
AUTOTASK_ACCOUNT_ID=2931
AUTOTASK_DEFAULT_ASSIGNEE_RESOURCE_ID=492
